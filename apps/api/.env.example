# Сервер баптаулары
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Деректер базасы (локальды SQLite немесе PostgreSQL мысалы: postgresql://user:pass@localhost:5432/oquplay)
DATABASE_URL="file:./dev.db"

# Қауіпсіздік және JWT
JWT_SECRET="oquplay-secret-key-replace-in-production-random-uuid"

# ЖИ провайдерінің баптаулары (бос болса қауіпсіз ДЕМО режимі қосылады)
# OpenAI үшін мысал:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# OpenRouter үшін мысал:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.0-flash-001
# LLM_API_KEY=sk-or-...

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
