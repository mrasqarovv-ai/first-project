# OquPlay AI — Ортаның айнымалылары (Environment Variables)

# Сервер порты мен хосты
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Деректер базасы (Локальды сынақ үшін SQLite: "file:./dev.db", немесе PostgreSQL: "postgresql://postgres:password@localhost:5432/oquplay?schema=public")
DATABASE_URL="file:./dev.db"

# JWT құпиясөзі (Production ортасында кездейсоқ ұзын хэш қойыңыз)
JWT_SECRET="oquplay-super-secret-jwt-token-change-in-production-2026"

# LLM ЖИ провайдерінің баптаулары:
# Егер LLM_API_KEY бос болса — автоматты түрде Педагогикалық ДЕМО режимі іске қосылады (API кілтсіз тестілеуге болады)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
